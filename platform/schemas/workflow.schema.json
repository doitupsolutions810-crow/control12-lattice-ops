{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "control12.workflow/v1",
  "type": "object",
  "required": ["name", "steps"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "context": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["agent", "artifact", "deployment-plan", "emit"] }
        }
      }
    }
  },
  "additionalProperties": false
}
