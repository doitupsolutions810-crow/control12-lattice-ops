# CONTROL12 production trust profile (paths 1, 3, 5)
# Copy to platform/.env.production and source before start. Never commit secrets.

# --- bind & token ---
CONTROL12_PLATFORM_HOST=127.0.0.1
CONTROL12_PLATFORM_PORT=4400
CONTROL12_PLATFORM_TOKEN=replace-with-openssl-rand-hex-32

# --- chat: closed on public edge ---
CONTROL12_CHAT_OPEN=0

# --- code: quorum-only writes ---
CONTROL12_CODE_REQUIRE_QUORUM=1
CONTROL12_CODE_STRICT_ALLOWLIST=0
CONTROL12_CODE_MAX_CONCURRENT=2
CONTROL12_CODE_RATE_LIMIT=15

# --- origin mTLS ---
CONTROL12_MTLS=1
CONTROL12_MTLS_DIR=${HOME}/.control12-mtls
CONTROL12_TLS_CERT=${HOME}/.control12-mtls/server.pem
CONTROL12_TLS_KEY=${HOME}/.control12-mtls/server.key
CONTROL12_TLS_CA=${HOME}/.control12-mtls/ca.pem
# CONTROL12_TLS_CA_PREVIOUS set automatically via ca-previous.pem during overlap

# --- renew ---
CONTROL12_MTLS_RENEW_DAYS=60
CONTROL12_MTLS_KEEP_BACKUPS=5

# --- logs ---
# CONTROL12_ACCESS_LOG defaults under CONTROL12_PLATFORM_ROOT/access.jsonl
CONTROL12_ANOMALY_401_MIN=20
