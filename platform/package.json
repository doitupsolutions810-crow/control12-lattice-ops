{
  "name": "@control12/sovereign-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node src/server.mjs",
    "start:chat-open": "CONTROL12_CHAT_OPEN=1 node src/server.mjs",
    "check": "node --check src/server.mjs && find src test -type f -name '*.mjs' -print0 | xargs -0 -n1 node --check",
    "test": "node --test test/*.test.mjs",
    "smoke": "bash scripts/smoke-test.sh",
    "tunnel": "bash scripts/tunnel.sh",
    "tunnel:named": "bash scripts/tunnel-named.sh",
    "tunnel:check": "bash scripts/check-tunnel-creds.sh",
    "tunnel:audit": "bash scripts/audit-access-logs.sh",
    "tunnel:remediate": "bash scripts/remediate-leaked-creds.sh",
    "mtls:gen": "bash scripts/gen-mtls-certs.sh"
  }
}
